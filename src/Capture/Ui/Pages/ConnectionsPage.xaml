<UserControl x:Class="CaptureApp.Ui.Pages.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CaptureApp.Ui">
    <!-- The site accounts Capture posts to: connected or not, sign in or out of each, or of all at once -->
    <StackPanel>
        <TextBlock Style="{StaticResource Title}" Text="{l:T nav.connections}"/>
        <TextBlock Style="{StaticResource Caption}" Text="{l:T accounts.subtitle}" Margin="0,0,0,14" TextWrapping="Wrap"/>

        <Border Style="{StaticResource Card}" Visibility="{Binding Available, Converter={StaticResource Vis}}">
            <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Logo}" Width="40" Height="40" FlowDirection="LeftToRight" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource StrokeStrong}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Sign in stands out; sign out is the quieter action; while still checking, neither -->
                            <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="130">
                                <Button Style="{StaticResource Primary}" Command="{Binding ActionCommand}" MinWidth="130" Content="{Binding ActionText}"
                                        AutomationProperties.Name="{Binding ActionText}"
                                        Visibility="{Binding ShowSignIn, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource Ghost}" Command="{Binding ActionCommand}" MinWidth="130" Content="{Binding ActionText}"
                                        AutomationProperties.Name="{Binding ActionText}"
                                        Visibility="{Binding IsConnected, Converter={StaticResource Vis}}"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Button Style="{StaticResource Ghost}" Command="{Binding SignOutAllCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                Visibility="{Binding Available, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xF3B1;" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T accounts.signOutAll}"/>
            </StackPanel>
        </Button>

        <Border Style="{StaticResource Card}" Visibility="{Binding Available, Converter={StaticResource Vis}, ConverterParameter=invert}">
            <TextBlock Text="{Binding UnavailableText}" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</UserControl>
